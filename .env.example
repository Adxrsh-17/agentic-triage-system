# Infermedica Clinical Engine API (Free Developer Trial at https://developer.infermedica.com)
INFERMEDICA_APP_ID=your_infermedica_app_id_here
INFERMEDICA_APP_KEY=your_infermedica_app_key_here
INFERMEDICA_MODEL=infermedica-en

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Pinecone Semantic Memory Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=smart-triage-patient-memory
PINECONE_DIMENSION=384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Google Maps API (Optional: Falls back to OpenStreetMap Nominatim & Overpass APIs)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
